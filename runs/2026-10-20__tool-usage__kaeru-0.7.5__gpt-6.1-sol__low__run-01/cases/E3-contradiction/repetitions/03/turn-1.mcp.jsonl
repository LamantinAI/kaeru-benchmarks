{"tool": "replace", "arguments": {"initiative": "auth-provider", "old": "1244d587-3aaa-5682-8977-456f9ee427e5", "successor": {"name": "token-lifetime-fact-corrected", "type": "reference", "tier": "archival", "body": "On the current provider plan, access tokens expire after fifteen minutes. The user verified this directly in the token payload and the provider dashboard. This corrects the previous one-hour assumption used by session handling. The previously recorded thirty-day refresh-token lifetime was not rechecked by this finding.", "source": {"text": "Found something while debugging the logouts: access tokens are expiring after\nfifteen minutes, not an hour. I checked the token payload directly and the\nprovider's dashboard agrees — the plan we're on has a shorter lifetime. That's\nwhy sessions drop."}}}, "response": {"api_version": 1, "data": {"affected": [], "artifacts": [], "changes": [], "created": [], "evidence": [], "failed_steps": [], "primary": null, "slots": []}, "issues": [{"code": "INVALID_ARGUMENT", "field": "/successor", "message": "{\"body\":\"On the current provider plan, access tokens expire after fifteen minutes. The user verified this directly in the token payload and the provider dashboard. This corrects the previous one-hour assumption used by session handling. The previously recorded thirty-day refresh-token lifetime was not rechecked by this finding.\",\"name\":\"token-lifetime-fact-corrected\",\"source\":{\"text\":\"Found something while debugging the logouts: access tokens are expiring after\\nfifteen minutes, not an hour. I checked the token payload directly and the\\nprovider's dashboard agrees — the plan we're on has a shorter lifetime. That's\\nwhy sessions drop.\"},\"tier\":\"archival\",\"type\":\"reference\"} is valid under more than one of the schemas listed in the 'oneOf' keyword", "retryable": false}], "operation": "replace", "replayed": false, "request_id": null, "state": "rejected"}, "error": null, "status": "failed"}
