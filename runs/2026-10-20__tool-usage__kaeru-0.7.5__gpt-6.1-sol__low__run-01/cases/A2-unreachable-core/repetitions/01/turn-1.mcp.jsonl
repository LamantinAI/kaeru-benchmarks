": "local"}, {"body": "Scope for the current sprint agreed: three features, one migration, no new dependencies.", "body_range": null, "created_at": "2026-10-20T12:44:28+00:00", "currentness": "current", "id": "3a8c6138-58a4-5b72-875f-46b8a11306d0", "initiatives": ["pipeline-reports"], "layer": "warm", "metadata_is_current": true, "name": "sprint-scope-agreed", "node_type": "episode", "properties": null, "recorded_at": "2026-10-20T12:44:28+00:00", "revision": "97aa78f7c54edc91f8e5dc84851075e9f099962d92a22e9fd82d3f964beb504d", "status": null, "successors": [], "tags": [], "tier": "operational", "visibility": "local"}, {"body": "Quarterly planning happens in the last week of the quarter.", "body_range": null, "created_at": "2026-10-20T12:44:47+00:00", "currentness": "current", "id": "3e64f6aa-ac51-5292-9499-4c488c8936c3", "initiatives": ["pipeline-reports"], "layer": "warm", "metadata_is_current": true, "name": "quarterly-planning-date", "node_type": "episode", "properties": null, "recorded_at": "2026-10-20T12:44:47+00:00", "revision": "7042b8fb0be64132c233a3a0d935464ecea5dd64622f7d9599533812b7b98803", "status": null, "successors": [], "tags": [], "tier": "operational", "visibility": "local"}, {"body": "Retro produced three actions; two are already done.", "body_range": null, "created_at": "2026-10-20T12:44:38+00:00", "currentness": "current", "id": "5025edd7-f42f-519e-858d-730ee3fa9621", "initiatives": ["pipeline-reports"], "layer": "warm", "metadata_is_current": true, "name": "retro-actions", "node_type": "episode", "properties": null, "recorded_at": "2026-10-20T12:44:38+00:00", "revision": "34d004135a11b72814a3a7a3cb9d320aca6bc14a72d436351e9487b8a677d9f2", "status": null, "successors": [], "tags": [], "tier": "operational", "visibility": "local"}, {"body": "Summaries go out at the end of each week. The operator reads them on\nMonday morning before deciding what to re-run.\n", "body_range": null, "created_at": "2026-10-20T12:44:59+00:00", "currentness": "current", "i