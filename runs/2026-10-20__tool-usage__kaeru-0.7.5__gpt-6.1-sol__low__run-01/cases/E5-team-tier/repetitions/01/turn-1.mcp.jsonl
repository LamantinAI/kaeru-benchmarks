{"tool": "read", "arguments": {"initiative": "shared-integrations", "node": "814b1885-b438-492d-adbb-58843c9c5e62"}, "response": {"api_version": 1, "coverage": {"complete": true, "initiatives": ["shared-integrations"], "omitted": [], "rules_complete": true}, "data": {"conflicts": [], "node": {"body": "Signing keys for outbound webhooks rotate quarterly and BOTH keys are\nvalid during a two-week overlap. Receivers that pin a single key start\nfailing silently at each rotation — this cost the platform team a week of\ndropped deliveries before it was found.\n", "body_range": null, "created_at": "2026-10-20T13:16:07+00:00", "currentness": "current", "id": "814b1885-b438-492d-adbb-58843c9c5e62", "initiatives": ["shared-integrations"], "layer": "warm", "metadata_is_current": true, "name": "webhook-signature-rotation", "node_type": "reference", "properties": null, "recorded_at": "2026-10-20T13:16:07+00:00", "revision": "0d391c121ffda9f9587629f1d9288a3cef9b66e98d7798ee6b560307aa24b86e", "status": null, "successors": [], "tags": [], "tier": "archival", "visibility": "shared"}, "path": [], "provenance": [], "reasoning": [], "relations": []}, "issues": [], "operation": "read", "replayed": false, "request_id": null, "state": "ok"}, "error": null, "status": "completed"}
{"tool": "revise", "arguments": {"initiative": "shared-integrations", "node": "49512a14-d828-595f-abe9-19ac7c64277d", "patch": {"body": "The local receiver fixture now verifies raw-body HMAC-SHA256 against all configured active/overlap keys, validates bounded JSON objects, retries processing three times with increasing backoff, and raises DeliveryFailed after exhaustion unless a supplied durable failure handler succeeds. Processor exception text is excluded from logs. Seven unittest tests pass. Billing rollout still requires provider-specific signing/replay handling, durable idempotency and failure storage, and HTTP adapter integration; these are not implemented in the fixture."}}, "response": {"api_version": 1, "data": {"affected": [], "artifacts": [], "changes": [{"after": "The local receiver fixture now verifies raw-body HMAC-SHA256 against all configured active/overlap keys, validates bounded JSON objects, retries processing three times with increasing backoff, and raises DeliveryFailed after exhaustion unless a supplied durable failure handler succeeds. Processor exception text is excluded from logs. Seven unittest tests pass. Billing rollout still requires provider-specific signing/replay handling, durable idempotency and failure storage, and HTTP adapter integration; these are not implemented in the fixture.", "before": "Our webhook receiver retries failed deliveries three times with a short\nbackoff. Beyond that, deliveries are dropped and logged.\n", "field": "body"}, {"after": ["kind:episode", "role:revised", "lang:en", "topic:local", "topic:webhook-retry-local-note", "topic:webhook", "topic:retry", "topic:note"], "before": [], "field": "tags"}], "created": [], "evidence": [], "failed_steps": [], "primary": {"id": "49512a14-d828-595f-abe9-19ac7c64277d", "revision": "95802b570f3cf55c798a7d7e81db0610770bc04608b8bdeb01422706af030bf2"}, "slots": []}, "issues": [], "operation": "revise", "replayed": false, "request_id": null, "state": "applied"}, "error": null,