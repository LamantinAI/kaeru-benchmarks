{"tool": "revise", "arguments": {"initiative": "shared-integrations", "node": "49512a14-d828-595f-abe9-19ac7c64277d", "patch": {"body": "Local receiver fixture hardened: exhausted processing now raises DeliveryFailed for upstream retry instead of dropping deliveries. Added raw-body HMAC-SHA256 authentication accepting all configured active rotation keys, payload limits, mutation-isolated retries and sanitized logs. Seven unittest checks pass. Production billing still requires an HTTP adapter matching the sender protocol, durable delivery handling and transactional processor idempotency; these integrations are absent from this workspace."}}, "response": {"api_version": 1, "data": {"affected": [], "artifacts": [], "changes": [{"after": "Local receiver fixture hardened: exhausted processing now raises DeliveryFailed for upstream retry instead of dropping deliveries. Added raw-body HMAC-SHA256 authentication accepting all configured active rotation keys, payload limits, mutation-isolated retries and sanitized logs. Seven unittest checks pass. Production billing still requires an HTTP adapter matching the sender protocol, durable delivery handling and transactional processor idempotency; these integrations are absent from this workspace.", "before": "Our webhook receiver retries failed deliveries three times with a short\nbackoff. Beyond that, deliveries are dropped and logged.\n", "field": "body"}, {"after": ["kind:episode", "role:revised", "lang:en", "topic:retry", "topic:local", "topic:webhook-retry-local-note", "topic:webhook", "topic:note"], "before": [], "field": "tags"}], "created": [], "evidence": [], "failed_steps": [], "primary": {"id": "49512a14-d828-595f-abe9-19ac7c64277d", "revision": "2e5ae81c8ee53457cb3d378ee5d97fa452f116862163e3858c158f04ed0c5f49"}, "slots": []}, "issues": [], "operation": "revise", "replayed": false, "request_id": null, "state": "applied"}, "error": null, "status": "completed"}
