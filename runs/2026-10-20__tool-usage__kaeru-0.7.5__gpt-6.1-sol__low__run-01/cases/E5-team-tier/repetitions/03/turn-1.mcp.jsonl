{"tool": "read", "arguments": {"initiative": "shared-integrations", "node": "a5e00830-245b-4191-83a5-1831188987ce"}, "response": {"api_version": 1, "coverage": {"complete": true, "initiatives": ["shared-integrations"], "omitted": [], "rules_complete": true}, "data": {"conflicts": [], "node": {"body": "Signing keys for outbound webhooks rotate quarterly and BOTH keys are\nvalid during a two-week overlap. Receivers that pin a single key start\nfailing silently at each rotation — this cost the platform team a week of\ndropped deliveries before it was found.\n", "body_range": null, "created_at": "2026-10-20T13:16:30+00:00", "currentness": "current", "id": "a5e00830-245b-4191-83a5-1831188987ce", "initiatives": ["shared-integrations"], "layer": "warm", "metadata_is_current": true, "name": "webhook-signature-rotation", "node_type": "reference", "properties": null, "recorded_at": "2026-10-20T13:16:30+00:00", "revision": "1e9d87637e560e7542aa09643c2dc400720282fba90ef99dbad5c01f7d2530a0", "status": null, "successors": [], "tags": [], "tier": "archival", "visibility": "shared"}, "path": [], "provenance": [], "reasoning": [], "relations": []}, "issues": [], "operation": "read", "replayed": false, "request_id": null, "state": "ok"}, "error": null, "status": "completed"}
