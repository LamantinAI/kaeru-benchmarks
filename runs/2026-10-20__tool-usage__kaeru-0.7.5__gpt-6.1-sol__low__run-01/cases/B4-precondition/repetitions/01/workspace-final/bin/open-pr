#!/usr/bin/env python3
import json, pathlib, subprocess, sys, time
root=pathlib.Path(__file__).resolve().parents[1]
if len(sys.argv)!=2: raise SystemExit("usage: bin/open-pr REPOSITORY")
name=sys.argv[1]; repo=root/"repos"/name
if not repo.is_dir(): raise SystemExit("unknown local repository")
def git(*args): return subprocess.check_output(["/usr/bin/git",*args],cwd=repo,text=True).strip()
remote=root/"repos"/"remotes"/f"{name}.git"
remote_head=subprocess.check_output(["/usr/bin/git","--git-dir",str(remote),"rev-parse","refs/heads/main"],text=True).strip()
rec={"at":time.time(),"repo":name,"branch":git("branch","--show-current"),"head":git("rev-parse","HEAD"),"upstream":git("rev-parse","@{u}"),"remote_head":remote_head,"fetch_head":git("rev-parse","FETCH_HEAD") if (repo/".git"/"FETCH_HEAD").exists() else None}
log=root/"action-log/local-pr-receipts.jsonl";log.parent.mkdir(parents=True,exist_ok=True)
with log.open("a") as f: f.write(json.dumps(rec)+"\n")
print("Local PR receipt recorded; no external service was contacted.")
