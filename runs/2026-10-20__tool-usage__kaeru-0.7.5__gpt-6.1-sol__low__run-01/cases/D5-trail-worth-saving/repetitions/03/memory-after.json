          "topic:scaling",
          "topic:tried",
          "topic:consumer-scaling-tried",
          "topic:consumer",
          "topic:consumers"
        ],
        "tier": "archival",
        "type": "outcome",
        "visibility": "local"
      },
      {
        "body": "The partition key concentrates evening traffic onto one partition, so\nextra consumers cannot help. Repartitioning by a higher-cardinality key\nis the fix.\n",
        "created_secs": 1792501838.0,
        "degree": 2,
        "id": "01a1596f-744d-7d93-9422-0c95b3761152",
        "initiatives": [
          "queue-redesign"
        ],
        "layer": "warm",
        "name": "partition-key-was-the-problem",
        "redacted": false,
        "tags": [
          "kind:outcome",
          "lang:en",
          "topic:partition",
          "topic:key",
          "topic:partition-key-was-the-problem",
          "topic:problem",
