    {
      "id": "01a10dce-d0ac-7601-af47-4362a82651b8",
      "name": "screen-capture-method-current",
      "type": "reference",
      "tier": "archival",
      "layer": "warm",
      "visibility": "local",
      "tags": [],
      "body": "HOW TO CAPTURE A TOOL WINDOW WITHOUT TAKING OVER THE SCREEN.\nFound 2026-06-20, replaces the earlier method in [[screen-capture-run-may]]\nand [[screen-capture-pipeline-restored]].\n\nHARD RULE (the user has complained twice): never bring the window to the\nfront, never activate it. The window must stay in the background.\n\nMETHOD: capture the window by its window id; this grabs the window\ncontents even while it is behind other windows.\n",
      "initiatives": [
        "capture-tooling"
      ],
      "created_secs": 1781956800.0,
      "degree": 1,
      "redacted": false
    },
