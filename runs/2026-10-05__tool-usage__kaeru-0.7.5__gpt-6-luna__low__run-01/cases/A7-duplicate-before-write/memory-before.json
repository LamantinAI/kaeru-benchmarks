    {
      "id": "01a10dd0-49ea-74d0-a2f7-5eb0757f0660",
      "name": "timeout-cascade-root-cause",
      "type": "reference",
      "tier": "archival",
      "layer": "warm",
      "visibility": "local",
      "tags": [],
      "body": "Root cause of the repeated timeout cascades: the retry budget is per\nrequest rather than per operation, so a slow dependency multiplies retries\nuntil the pool is exhausted. Fixing it means moving the budget up a level;\nraising timeouts only moves the cliff.\n",
      "initiatives": [
        "incident-log"
      ],
