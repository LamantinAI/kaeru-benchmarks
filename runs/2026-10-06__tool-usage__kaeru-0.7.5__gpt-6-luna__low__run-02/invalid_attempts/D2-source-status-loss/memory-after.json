    {
      "id": "01a1127a-4c03-7950-b369-1ecb1da339ca",
      "name": "latency-test-ambiguous-result",
      "type": "episode",
      "tier": "operational",
      "layer": "warm",
      "visibility": "local",
      "tags": [
        "kind:observation",
        "sig:medium",
        "lang:en",
        "topic:latency",
        "topic:test",
        "topic:ambiguous",
        "topic:result",
        "topic:latency-test-ambiguous-result"
      ],
      "body": "Latency test result (2026-10-06): ambiguous. Rate limiting explains the daytime spikes but not the overnight spikes. Cold starts have the opposite explanatory gap: they may fit the overnight spikes, but do not explain the daytime ones. Neither hypothesis accounts for the full pattern. We cannot separate the causes with current instrumentation, so attribution remains unresolved; do not treat either as established.",
      "initiatives": [
        "latency-investigation"
      ],
      "created_secs": 1791311367.0,
      "degree": 1,
      "redacted": false
